@App:name("FireIncidentDemo")

/* -----------------------------
   INPUT STREAMS
   ----------------------------- */

/*  Actor / Crew / Tactical Lead actions */
@source(
    type='http',
    receiver.url="http://0.0.0.0:7071/actor",
    @map(type='json', @attributes(incident_id='$.incident_id', action='$.action', value='$.value'))
)
define stream ActorStream(incident_id string, action string, value string);

/*  Humidity Sensor (unit is %) */
@source(
    type='http',
    receiver.url="http://0.0.0.0:7071/humidity",
    @map(type='json')
)
define stream HumidityStream(incident_id string, humidity int);

/* Wind sensor */
@source(
    type='http',
    receiver.url="http://0.0.0.0:7071/wind",
    @map(type='json')
)
define stream WindStream(incident_id string, wind_direction string);

/* Middleman callback */
@source(
    type='http',
    receiver.url="http://0.0.0.0:7072/middleman",
    @map(type='json')
)
define stream MiddlemanStream(
    incident_id string,
    case_id string,
    event string,
    timestamp string,
    role string,
    payload string,
    error string
);


/* -----------------------------
   TABLES & INTERNAL CEP STREAM
   ----------------------------- */

@primaryKey('incident_id')
define table IncidentCases(
    incident_id string,
    case_id string
);

define stream CepDetectedEvents(
    incident_id string,
    action string,
    value string
);


/* -----------------------------
   OUTPUT STREAMS (to microservice)
   ----------------------------- */

@sink(type='http',
      publisher.url='http://microservice:5001/InitIncidentOut',
      method='POST',
      @map(type='json'))
define stream InitIncidentOut(incident_id string, action string);
define stream InitIncidentOutAttempt(incident_id string, case_id string, action string);


@sink(type='http',
      publisher.url='http://microservice:5001/ExecuteEventOut',
      method='POST',
      @map(type='json'))
define stream ExecuteEventOut(incident_id string, case_id string, action string, value string);
define stream ExecuteEventOutAttempt(incident_id string, case_id string, action string, value string);


@sink(type='http',
      publisher.url='http://microservice:5001/get_available_actions',
      method='POST',
      @map(type='json'))
define stream GetAvailableActionsOut(incident_id string, case_id string);
define stream GetAvailableActionsOutAttempt(incident_id string, case_id string);

define stream ErrorStream(incident_id string, error string);

/* -----------------------------
   OUTPUT STREAMS (to logging)
   ----------------------------- */

@sink(type='http',
      publisher.url='http://logging-service:5010/log',
      method='POST',
      @map(type='json'))
define stream Logging(
    event string,
    case_id string,
    incident_id string,
    timestamp string,
    role string,
    payload string,
    error string
);


/* CEP */

/* initialize sensor data such that the very next event checks threshold */
from ActorStream[action == "SetupSensors"]
select incident_id, 25 as humidity
insert into HumidityStream;

/*humidity: crossing 15% threshold */
partition with (incident_id of HumidityStream)
begin
    from every (e1=HumidityStream[humidity >= 15] -> e2=HumidityStream[humidity < 15])
    select e2.incident_id, "Humidity" as action, convert(e2.humidity, "string") as value
    insert into CepDetectedEvents;

    from every (e1=HumidityStream[humidity < 15] -> e2=HumidityStream[humidity >= 15])
    select e2.incident_id, "Humidity" as action, convert(e2.humidity, "string") as value
    insert into CepDetectedEvents;
end;

/* consecutive different wind directions. */
partition with (incident_id of WindStream)
begin
    from every e1=WindStream, e2=WindStream[wind_direction != e1.wind_direction]
    select e2.incident_id, "ChangeInWindDirection" as action, e2.wind_direction as value
    insert into CepDetectedEvents;
end;


/* -----------------------------
   ROUTING LOGIC
   ----------------------------- */

/* Incident registration */
from ActorStream[action == "ArriveOnScene"] as A
left outer join IncidentCases as I
    on A.incident_id == I.incident_id
select A.incident_id, I.case_id, A.action
insert into InitIncidentOutAttempt;

from InitIncidentOutAttempt[not(incident_id is null)]
select incident_id, action
insert into InitIncidentOut;

from InitIncidentOutAttempt[incident_id is null]
select "missing_id" as incident_id, "Didn't receive an incident_id" as error
insert into ErrorStream;


/* Actor events */
from ActorStream[action != "ArriveOnScene"] as A
left outer join IncidentCases as I
    on A.incident_id == I.incident_id
select A.incident_id, I.case_id, A.action, ifThenElse(A.value is null, "", A.value) as value
insert into ExecuteEventOutAttempt;


/* CEP-derived sensor events */
from CepDetectedEvents as C
left outer join IncidentCases as I
    on C.incident_id == I.incident_id
select C.incident_id, I.case_id, C.action, ifThenElse(C.value is null, "", C.value) as value
insert into ExecuteEventOutAttempt;


/* Execute validated events against DCR */
from ExecuteEventOutAttempt[not(case_id is null)]
select incident_id, case_id, action, value
insert into ExecuteEventOut;

from ExecuteEventOutAttempt[case_id is null]
select incident_id, "Cannot execute event for an incident that has not arrived on scene yet" as error
insert into ErrorStream;


/* -----------------------------
   MIDDLEMAN CALLBACKS
   ----------------------------- */

/* Middleman tells Siddhi the incident case is created on ArriveOnScene */
from MiddlemanStream[event == "ArriveOnScene" and (error == "" or error is null)]
select incident_id, case_id
update or insert into IncidentCases
    set IncidentCases.case_id = case_id
    on IncidentCases.incident_id == incident_id;


/* -----------------------------
   ERROR & AUDIT LOGGING
   ----------------------------- */

from ErrorStream
select "Error" as event, "UNKNOWN_CASE" as case_id, incident_id, convert(currentTimeMillis(), "string") as timestamp, "system" as role, "" as payload, error
insert into Logging;

from MiddlemanStream
select event, case_id, incident_id, timestamp, role, payload, ifThenElse(error is null, "", error) as error
insert into Logging;
