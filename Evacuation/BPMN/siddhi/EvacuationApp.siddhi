@App:name("EvacuationApp")

/* -----------------------------
   INPUT STREAMS
   ----------------------------- */

@source(
    type='http',
    receiver.url="http://0.0.0.0:7071/customer",
    @map(type='json')
)
define stream CustomerStream(
    incident_id string,
    action string,
    all_accounted_for bool,
    case_id string,
    situation string,
    threat string
);

@source(
    type='http',
    receiver.url="http://0.0.0.0:7072/middleman",
    @map(type='json')
)
define stream MiddlemanStream(
    incident_id string,
    case_id string,
    event string,
    timestamp string,
    role string,
    payload string,
    error string
);

/* -----------------------------
   CAMUNDA COMMAND OUTPUTS
   ----------------------------- */

@sink(
    type='http',
    publisher.url='http://communication:5001/start_evacuation',
    method='POST',
    @map(type='json')
)
define stream EvacuationOrderOut(
    incident_id string,
    all_accounted_for bool
);

@sink(
    type='http',
    publisher.url='http://communication:5001/fire_situation_changed',
    method='POST',
    @map(type='json')
)
define stream FireSituationChangedOut(
    incident_id string,
    case_id string,
    situation string
);

@sink(
    type='http',
    publisher.url='http://communication:5001/crew_safety_threat',
    method='POST',
    @map(type='json')
)
define stream CrewSafetyThreatOut(
    incident_id string,
    case_id string,
    threat string
);

/* -----------------------------
   LOGGER OUTPUT
   ----------------------------- */

@sink(
    type='http',
    publisher.url='http://logging-service:5010/log',
    method='POST',
    @map(type='json')
)
define stream Logging(
    event string,
    case_id string,
    incident_id string,
    timestamp string,
    role string,
    payload string,
    error string
);

define stream RoutingError(
    incident_id string,
    error string
);

/* -----------------------------
   CUSTOMER EVENT ROUTING
   ----------------------------- */

from CustomerStream[action == "EvacuationOrdered" and not(incident_id is null)]
select incident_id, all_accounted_for
insert into EvacuationOrderOut;

from CustomerStream[action == "FireSituationChanged" and not(incident_id is null)]
select incident_id, case_id, situation
insert into FireSituationChangedOut;

from CustomerStream[action == "CrewSafetyThreat" and not(incident_id is null)]
select incident_id, case_id, threat
insert into CrewSafetyThreatOut;

/* Invalid customer input is logged without calling Camunda. */
from CustomerStream[incident_id is null or action is null]
select incident_id, "incident_id and action are required" as error
insert into RoutingError;

from CustomerStream[
    action != "EvacuationOrdered"
]
select incident_id, "unsupported action" as error
insert into RoutingError;

/* -----------------------------
   CAMUNDA CALLBACKS
   ----------------------------- */

from MiddlemanStream
select event,
       case_id,
       incident_id,
       timestamp,
       role,
       payload,
       ifThenElse(error is null, "", error) as error
insert into Logging;

from RoutingError
select "Error" as event,
       "UNKNOWN_CASE" as case_id,
       incident_id,
       convert(currentTimeMillis(), "string") as timestamp,
       "siddhi" as role,
       "" as payload,
       error
insert into Logging;
