<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Evacuation_v3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_Evacuation">
    <bpmn:participant id="Participant_Evacuation" name="Evacuation and Cordon" processRef="Process_Evacuation" />
    <bpmn:participant id="Participant_Police" name="Police" processRef="Process_Police" />
    <bpmn:participant id="Participant_Reception" name="Reception Center" processRef="Process_Reception" />
    <bpmn:participant id="Participant_Cep" name="Cep" processRef="Process_Cep" />
    <bpmn:messageFlow id="Msg_Start" name="Evacuation decision" sourceRef="Participant_Police" targetRef="Event_Start" />
    <bpmn:messageFlow id="Msg_CepRequest" name="Request fire and traffic data" sourceRef="Activity_ReqCep" targetRef="Participant_Cep" />
    <bpmn:messageFlow id="Msg_CepSituation" name="Fire and traffic situation" sourceRef="Participant_Cep" targetRef="Event_CepReceived" />
    <bpmn:messageFlow id="Msg_EarlyWarning" name="Early warning: predicted spread threatens inhabited area" sourceRef="Participant_Cep" targetRef="Participant_Police" />
    <bpmn:messageFlow id="Msg_Cordon" name="Request outer cordon" sourceRef="Activity_ReqPolice" targetRef="Participant_Police" />
    <bpmn:messageFlow id="Msg_Capacity" name="Reserve capacity" sourceRef="Activity_ReqCap" targetRef="Participant_Reception" />
    <bpmn:messageFlow id="Msg_Transport" name="Evacuees transported" sourceRef="Activity_Evac" targetRef="Participant_Reception" />
    <bpmn:messageFlow id="Msg_Search" name="Assistance for refusing persons" sourceRef="Activity_Search" targetRef="Participant_Police" />
    <bpmn:messageFlow id="Msg_Handover" name="Registers, cordon and evidence handed over" sourceRef="Activity_Handover" targetRef="Participant_Police" />
    <bpmn:messageFlow id="Msg_Blocked" sourceRef="Participant_Cep" targetRef="Event_SubStart" />
    <bpmn:messageFlow id="Msg_CrewThreat" name="Crew safety threat" sourceRef="Participant_Cep" targetRef="Event_CrewStart" />
    <bpmn:textAnnotation id="TextAnnotation_Laces">
      <bpmn:text>Lookouts, Awareness, Communications, Escape routes, Safety zones</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Missing">
      <bpmn:text>Store residents of the zone who are not yet evacuated (GDPR: only necessary data)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Inner">
      <bpmn:text>BRS cordons the site until police arrive</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Evacuated">
      <bpmn:text>Store name, time, reception center, and entries without consent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Cep">
      <bpmn:text>Complex Event Processing of fire spread and traffic data</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Situation">
      <bpmn:text>Fire perimeter, predicted spread and road status are used to define zones and select routes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Crew">
      <bpmn:text>CEP rule: fast fire spread, wind shift or closing escape route near field crews</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0lvyx31">
      <bpmn:text>All Persons accounted for?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Laces" associationDirection="None" sourceRef="Activity_Safety" targetRef="TextAnnotation_Laces" />
    <bpmn:association id="Association_Missing" associationDirection="None" sourceRef="Activity_Register" targetRef="TextAnnotation_Missing" />
    <bpmn:association id="Association_Inner" associationDirection="None" sourceRef="Activity_Inner" targetRef="TextAnnotation_Inner" />
    <bpmn:association id="Association_Evacuated" associationDirection="None" sourceRef="Activity_RegEv" targetRef="TextAnnotation_Evacuated" />
    <bpmn:association id="Association_Cep" associationDirection="None" sourceRef="Subprocess_Traffic" targetRef="TextAnnotation_Cep" />
    <bpmn:association id="Association_Situation" associationDirection="None" sourceRef="Activity_ReqCep" targetRef="TextAnnotation_Situation" />
    <bpmn:association id="Association_Crew" associationDirection="None" sourceRef="Subprocess_Crew" targetRef="TextAnnotation_Crew" />
    <bpmn:association id="Association_1dv19mb" associationDirection="None" sourceRef="Gateway_All" targetRef="TextAnnotation_0lvyx31" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Evacuation" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Evacuation">
      <bpmn:lane id="Lane_Monitoring" name="Monitoring">
        <bpmn:flowNodeRef>Subprocess_Traffic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Subprocess_Crew</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Field" name="Field">
        <bpmn:flowNodeRef>Activity_ReqCap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Inner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Evac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RegEv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_All</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Command" name="Command">
        <bpmn:flowNodeRef>Event_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReqCep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CepReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Zones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Safety</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReqPolice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Clear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Handover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Evacuation ordered">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Start" messageRef="Message_Evac" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_ReqCep" name="Request fire and traffic data from CEP">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request_cep_situation" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_CepReceived" name="Situation picture received">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_0b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Situation" messageRef="Message_Situation" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_Zones" name="Define zones from fire boundaries">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="define_zones" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0b</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Safety" name="Assess crew safety (LACES)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assess_crew_safety" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Register" name="Create missing persons register">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create_missing_register" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Select" name="Select reception center and routes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="select_reception_center" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_3b</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_ReqPolice" name="Request outer cordon from police">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request_police_cordon" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3b</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_ReqCap" name="Reserve reception capacity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve_reception_capacity" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Inner" name="Establish inner cordon">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="establish_inner_cordon" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Evac" name="Evacuate citizens by sector">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="evacuate_citizens" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_RegEv" name="Register evacuated and log property entries">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register_evacuated" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Search" name="Search for remaining persons">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="search_remaining_persons" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Loop</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Clear" name="Confirm zone cleared">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="confirm_zone_cleared" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Handover" name="Hand over registers and evidence to police">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handover_to_police" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_All">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_End" name="Evacuation completed">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Subprocess_Traffic" name="Monitor fire spread and road conditions" triggeredByEvent="true">
      <bpmn:startEvent id="Event_SubStart" name="Fire boundary crossed or route blocked" isInterrupting="false">
        <bpmn:outgoing>Flow_S1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_Blocked" messageRef="Message_Blocked" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_UpdRoutes" name="Update zones and evacuation routes">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="update_zones_and_routes" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S1</bpmn:incoming>
        <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Activity_NotifyTeams" name="Notify field teams and police">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify_field_teams" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_S2</bpmn:incoming>
        <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_SubEnd" name="Routes updated">
        <bpmn:incoming>Flow_S3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="Event_SubStart" targetRef="Activity_UpdRoutes" />
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="Activity_UpdRoutes" targetRef="Activity_NotifyTeams" />
      <bpmn:sequenceFlow id="Flow_S3" sourceRef="Activity_NotifyTeams" targetRef="Event_SubEnd" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Subprocess_Crew" name="Monitor crew safety" triggeredByEvent="true">
      <bpmn:startEvent id="Event_CrewStart" name="Crew safety threat detected" isInterrupting="false">
        <bpmn:outgoing>Flow_C1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_Crew" messageRef="Message_Crew" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_Withdraw" name="Order crews to withdraw to safety zones">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="withdraw_crews_to_safety_zones" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_C1</bpmn:incoming>
        <bpmn:outgoing>Flow_C2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_CrewEnd" name="Crews warned">
        <bpmn:incoming>Flow_C2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_C1" sourceRef="Event_CrewStart" targetRef="Activity_Withdraw" />
      <bpmn:sequenceFlow id="Flow_C2" sourceRef="Activity_Withdraw" targetRef="Event_CrewEnd" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Event_Start" targetRef="Activity_ReqCep" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Activity_ReqCep" targetRef="Event_CepReceived" />
    <bpmn:sequenceFlow id="Flow_0b" sourceRef="Event_CepReceived" targetRef="Activity_Zones" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Activity_Zones" targetRef="Activity_Safety" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Safety" targetRef="Activity_Register" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Register" targetRef="Activity_Select" />
    <bpmn:sequenceFlow id="Flow_3b" sourceRef="Activity_Select" targetRef="Activity_ReqPolice" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_ReqPolice" targetRef="Activity_ReqCap" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_ReqCap" targetRef="Activity_Inner" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Inner" targetRef="Activity_Evac" />
    <bpmn:sequenceFlow id="Flow_Loop" sourceRef="Activity_Search" targetRef="Activity_Evac" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Evac" targetRef="Activity_RegEv" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_RegEv" targetRef="Gateway_All" />
    <bpmn:sequenceFlow id="Flow_No" name="persons missing" sourceRef="Gateway_All" targetRef="Activity_Search">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allAccountedFor = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Yes" name="all persons accounted for" sourceRef="Gateway_All" targetRef="Activity_Clear">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=allAccountedFor = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Clear" targetRef="Activity_Handover" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="Activity_Handover" targetRef="Event_End" />
  </bpmn:process>
  <bpmn:process id="Process_Police" isExecutable="false" />
  <bpmn:process id="Process_Reception" isExecutable="false" />
  <bpmn:process id="Process_Cep" isExecutable="false" />
  <bpmn:message id="Message_Evac" name="EvacuationOrdered" />
  <bpmn:message id="Message_Blocked" name="FireSituationChanged">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=incidentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Situation" name="FireTrafficSituation">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=incidentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Crew" name="CrewSafetyThreat">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=incidentId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Evacuation">
