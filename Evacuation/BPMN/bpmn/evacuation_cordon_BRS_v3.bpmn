      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Subprocess_Traffic_di" bpmnElement="Subprocess_Traffic" isExpanded="true">
        <dc:Bounds x="690" y="900" width="440" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_SubStart_di" bpmnElement="Event_SubStart">
